{
  "name": "movieshub-api",
  "version": "2.0.0",
  "description": "BFF do MovieHub em Azure Functions (Node.js v4) — consome o microsserviço movies-catalog",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "func start",
    "test": "node --test --test-reporter=spec \"test/**/*.test.js\"",
    "test:unit": "node --test --test-reporter=spec \"test/unit/*.test.js\" \"test/integration/*.test.js\"",
    "test:e2e": "node --test --test-reporter=spec \"test/e2e/*.test.js\"",
    "test:arch": "node --test --test-reporter=spec \"test/architecture/*.test.js\""
  },
  "dependencies": {
    "@azure/functions": "^4.5.1"
  },
  "devDependencies": {
    "archunit": "^2.5.4",
    "azure-functions-core-tools": "^4.0.6610",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
